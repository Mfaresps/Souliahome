# SOULIA — إعدادات النسخ الاحتياطي السحابي
# ---------------------------------------------------------------------------
#   cp scripts/cloud-backup.env.example scripts/cloud-backup.env
#   chmod 600 scripts/cloud-backup.env
#
# ⚠ cloud-backup.env مستبعد من git (.gitignore). لا ترفعه أبداً.
# ⚠ مفاتيح R2 ليست هنا — هي في ~/.config/rclone/rclone.conf فقط.
# ---------------------------------------------------------------------------

# ── قاعدة البيانات ──
MONGO_CONTAINER=soulia-mongodb
MONGO_USER=soulia
MONGO_PASS=ضع_كلمة_سر_مونجو_هنا
MONGO_DB=soulia

# ── الوجهة على السحابة ──
# RCLONE_REMOTE هو الاسم الذي اخترته في `rclone config` (مثال: r2)
RCLONE_REMOTE=r2
BUCKET=soulia-backups
PREFIX=mongo

# ── سياسة الاحتفاظ ──
KEEP=14          # عدد النسخ التي تبقى على السحابة
LOCAL_KEEP=3     # عدد النسخ التي تبقى على السيرفر

# ── المسارات ──
WORK_DIR=/var/backups/soulia

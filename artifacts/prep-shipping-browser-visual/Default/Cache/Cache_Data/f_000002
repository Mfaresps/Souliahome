/* Keep settings grid items inside the available width rather than clipping them. */
#page-settings .settings-page-inner,
#page-settings .stg-layout,
#page-settings .stg-mobile-nav-wrap,
#page-settings .stg-panels,
#page-settings .stg-panel,
#page-settings .settings-card,
#page-settings .settings-stack,
#page-settings .stg-card-title-text,
#page-settings .form-group{min-width:0;max-width:100%;box-sizing:border-box}
#page-settings .stg-layout{grid-template-columns:220px minmax(0,1fr)}
#page-settings .stg-grid-2,#page-settings .settings-price-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
#page-settings .settings-card{overflow-wrap:anywhere}
#page-settings .form-group input,#page-settings .form-group select,#page-settings textarea{min-width:0;max-width:100%;box-sizing:border-box}
#notification-settings .push-heading>div{min-width:0}

/* Settings workspace: one navigation rail and a clear content hierarchy. */
#page-settings{--stg-radius:12px}
#page-settings .settings-page-inner{width:100%;max-width:1180px;margin-inline:auto}
#page-settings .stg-layout{grid-template-columns:208px minmax(0,1fr);gap:20px}
#page-settings .stg-content{min-width:0}
#page-settings .stg-provider-hidden{display:none!important}
#page-settings .stg-provider-tabs[hidden]{display:none}
#page-settings .stg-provider-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:18px}
#page-settings .stg-provider-tabs button{display:flex;align-items:center;gap:10px;padding:12px 10px;min-width:0;border:1px solid var(--border);border-radius:11px;background:var(--surface);color:var(--text);font:inherit;text-align:start;cursor:pointer}
#page-settings .stg-provider-tabs button:hover{border-color:var(--primary)}
#page-settings .stg-provider-tabs button[aria-selected=true]{border-color:var(--primary);background:var(--primary-pale);box-shadow:inset 0 0 0 1px var(--primary)}
#page-settings .stg-provider-brand{display:grid;place-items:center;flex:0 0 66px;width:66px;height:40px;padding:3px;border-radius:7px;background:white;box-sizing:border-box}
#page-settings .stg-provider-brand img{max-width:100%;max-height:100%;object-fit:contain}
#page-settings .stg-provider-tabs button>span:last-child{min-width:0}
#page-settings .stg-provider-tabs strong{display:block;font-size:.82rem;line-height:1.5}
#page-settings .stg-provider-tabs small{display:block;color:var(--muted);font-size:.65rem;line-height:1.6;margin-top:2px}
#page-settings .stg-provider-connection{display:inline-flex;align-items:center;gap:5px;margin-top:5px;font-size:10px;font-weight:600;line-height:1.5;color:var(--muted)}
#page-settings .stg-provider-connection::before{content:"";width:6px;height:6px;flex:0 0 6px;border-radius:50%;background:currentColor}
#page-settings .stg-provider-connection:is([data-state=connected],[data-state=webhook]){color:#16834a}
#page-settings .stg-provider-connection:is([data-state=connected],[data-state=webhook])::before{box-shadow:0 0 0 3px #16834a16}
#page-settings .stg-provider-connection:is([data-state=configured],[data-state=error]){color:#a66b08}
#page-settings .stg-provider-connection[data-state=disconnected]{color:#d14343}
body.dark-mode #page-settings .stg-provider-connection:is([data-state=connected],[data-state=webhook]){color:#5fce91}
body.dark-mode #page-settings .stg-provider-connection:is([data-state=configured],[data-state=error]){color:#e8b860}
body.dark-mode #page-settings .stg-provider-connection[data-state=disconnected]{color:#f18b8b}
#page-settings #stg-shopify-card>input{display:block;max-width:460px;min-height:34px;padding:6px 9px;box-sizing:border-box}
#page-settings #stg-shopify-card>label{display:block;font-size:.78rem;font-weight:600}
#page-settings #stg-shopify-card>p{max-width:660px;line-height:1.7}
#page-settings #stg-shopify-card .stg-provider-logo img{width:24px;height:28px;object-fit:contain}
#page-settings :is(#stg-bosta-card,#stg-bosta-webhook-card) .stg-card-title-icon{width:48px;background:white url('/bosta-logo-original.png') center/42px auto no-repeat}
#page-settings :is(#stg-bosta-card,#stg-bosta-webhook-card) .stg-card-title-icon .bosta-icon{display:none}
#page-settings #stg-r2-card .stg-card-title-icon{width:48px;background:white url('/cloudflare-logo-original.png') center/42px auto no-repeat}
#page-settings #stg-r2-card .stg-card-title-icon svg{visibility:hidden}
#page-settings .stg-content-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:0 0 12px;margin-bottom:14px;border-bottom:1px solid var(--border)}
#page-settings .stg-content-heading h3{font-size:1.15rem;line-height:1.5;margin:3px 0 6px;color:var(--text)}
#page-settings .stg-content-heading p{margin:0;color:var(--muted);font-size:.78rem;line-height:1.8}
#page-settings .stg-content-heading .stg-eyebrow{font-size:.65rem;color:var(--primary);font-weight:700}
#page-settings .stg-section-marker{display:grid;place-items:center;width:44px;height:44px;flex:0 0 44px;border:1px solid var(--border);border-radius:13px;background:var(--surface);color:var(--primary)}
#page-settings .stg-section-marker svg{width:24px;height:24px}
#page-settings .stg-sidebar{padding:10px;box-shadow:none}
#page-settings .stg-nav-caption{font-size:.65rem;letter-spacing:0;padding:14px 10px 6px}
#page-settings .stg-nav-caption:first-child{padding-top:5px}
#page-settings .stg-tab-btn{white-space:normal;text-align:start;line-height:1.6;min-height:44px;font-size:.8rem}
#page-settings .stg-tab-btn.active{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--primary) 10%,transparent)}
#page-settings .stg-card-title{flex-wrap:wrap;align-items:center;padding-bottom:10px;margin-bottom:12px;gap:9px;border-bottom:1px solid var(--border)}
#page-settings .stg-card-title-text{flex:1;min-width:130px}
#page-settings .stg-card-title>div:last-child:not(.stg-card-title-text):not(.stg-card-title-icon){flex-wrap:wrap;max-width:100%}
#page-settings .settings-card{padding:14px 16px;box-shadow:none;scroll-margin-top:92px}
#page-settings .settings-card:hover{box-shadow:none}
#page-settings .settings-pref-body{min-width:0;gap:8px!important}
#page-settings :is(#stg-appearance-card,#stg-mov-kpi-card) .settings-pref-body{max-width:480px}
#page-settings .settings-pref-body>label.flex{justify-content:space-between;flex-direction:row-reverse;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg-alt)}
#page-settings .form-group input,#page-settings .form-group select{min-height:34px;padding:6px 9px;font-size:.8rem;width:100%;max-width:420px}
#page-settings .form-group input[type=number]{max-width:160px}
#page-settings .btn{min-height:32px;padding:6px 12px;font-size:.78rem}
#page-settings .stg-card-title-icon{width:30px;height:30px;border-radius:8px}
#page-settings .settings-section-label{margin-bottom:8px}
#page-settings .stg-panel>.settings-section-label:not(:first-child),#page-settings .stg-panel>.stg-section:not(:first-child){margin-top:18px}
#page-settings .settings-price-grid{grid-template-columns:repeat(2,minmax(0,160px));gap:16px}
#page-settings .settings-ship-add{display:flex;flex-direction:row;align-items:center;gap:8px;padding-top:12px;margin-top:12px}
#page-settings .settings-ship-add #new-ship-name{width:220px;max-width:100%;min-width:0;padding:6px 9px}
#page-settings .settings-ship-prices{display:grid;grid-template-columns:repeat(2,minmax(0,110px));gap:8px;min-width:0}
#page-settings .settings-ship-prices input{width:100%;max-width:100%;padding:6px 9px}
#page-settings .settings-ship-add .btn{width:auto;white-space:nowrap}
#page-settings .stg-shipping-table-wrap{width:100%;max-height:400px;overflow:auto;border:1px solid var(--border);border-radius:10px;scrollbar-width:thin;scrollbar-color:var(--border) transparent;isolation:isolate}
#page-settings #ship-table{width:100%;min-width:560px;table-layout:fixed;border-collapse:separate;border-spacing:0;font-size:.78rem;margin:0}
#page-settings #ship-table :is(th,td){box-sizing:border-box;text-align:start;padding:12px;vertical-align:middle;border-bottom:1px solid var(--border);line-height:1.6}
#page-settings #ship-table th{position:sticky;top:0;z-index:2;background:var(--bg-alt);font-size:.7rem;font-weight:600;white-space:nowrap}
#page-settings #ship-table th:nth-child(2),#page-settings #ship-table th:nth-child(3){width:108px;text-align:center}
#page-settings #ship-table :is(th,td):last-child{position:sticky;inset-inline-end:0;width:92px;background:var(--surface);border-inline-start:1px solid var(--border);z-index:1;text-align:center}
#page-settings #ship-table th:last-child{background:var(--bg-alt);z-index:3}
#page-settings #ship-table tbody tr:last-child td{border-bottom:0}
#page-settings #ship-table tbody tr:hover td{background:var(--bg-alt)}
#page-settings .stg-ship-company-name{font-size:.82rem;font-weight:650;overflow-wrap:anywhere;color:var(--text);margin-bottom:5px}
#page-settings .stg-ship-company-meta{display:flex;align-items:center;flex-wrap:wrap;gap:5px}
#page-settings .stg-ship-company-meta :is(.cpk-link,.carrier-id){margin:0!important;font-size:.62rem;padding:2px 6px;border-radius:5px;line-height:1.5}
#page-settings .stg-ship-company-meta .carrier-id{direction:ltr;unicode-bidi:isolate;color:var(--muted);background:var(--bg-alt)}
#page-settings #ship-table input[type=number]{display:block;width:84px;max-width:100%;min-height:32px;box-sizing:border-box;margin:0 auto;padding:5px 7px;text-align:center;font-size:.8rem;font-variant-numeric:tabular-nums;border-radius:8px;background:var(--surface)}
#page-settings .stg-ship-actions{display:flex;align-items:center;justify-content:center;gap:6px}
#page-settings .stg-ship-actions .btn-icon{display:grid;place-items:center;width:28px;height:28px;min-height:28px;padding:0;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--muted);flex-shrink:0}
#page-settings .stg-ship-actions .btn-icon:hover{color:var(--primary);border-color:var(--primary)}
#page-settings .stg-ship-actions .btn-danger{color:var(--red);background:color-mix(in srgb,var(--red) 5%,var(--surface));border-color:color-mix(in srgb,var(--red) 25%,var(--border))}
#page-settings .stg-ship-actions .btn-danger:hover{border-color:var(--red);color:var(--red)}
#page-settings #stg-ship-companies-card .settings-ship-add{display:grid;grid-template-columns:minmax(140px,1fr) 216px auto;align-items:end;gap:10px;padding-top:14px;margin-top:14px}
#page-settings .settings-ship-add label{display:flex;flex-direction:column;min-width:0;gap:5px;margin:0;font-size:.7rem;font-weight:600;color:var(--muted)}
#page-settings .settings-ship-add .settings-ship-prices{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
#page-settings #stg-ship-companies-card #new-ship-name{width:100%;max-width:none;min-height:34px;font-size:.78rem;margin:0}
#page-settings .settings-ship-add .settings-ship-prices input{min-height:34px;font-size:.78rem;margin:0;box-sizing:border-box}
#page-settings #an-composer .an-field{margin-top:12px}
#page-settings #an-composer .an-msg{min-height:90px;padding:8px 10px}
#page-settings #an-composer .an-types{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
#page-settings #an-composer .an-type{padding:7px 9px}

/* Keep the weekly matrix at the card width, with scrolling owned by its frame. */
#page-settings #emp-shifts-table-wrap{width:100%;max-width:100%;min-width:0;box-sizing:border-box;overflow:auto;max-height:560px;scrollbar-width:thin;scrollbar-color:var(--border) transparent}
#page-settings #emp-shifts-table-body:has(.sm-tbl){padding:0!important;text-align:start}
#page-settings .sm-tbl{width:100%;min-width:780px;table-layout:fixed}
#page-settings .sm-tbl :is(th,td){box-sizing:border-box}
#page-settings .sm-tbl :is(.sm-emp-h,.sm-emp){width:132px;min-width:0;position:sticky;inset-inline-start:0;background:var(--surface);z-index:3;border-inline-end:1px solid var(--border);padding:10px 12px;text-align:start}
#page-settings .sm-tbl thead .sm-emp-h{z-index:5;background:var(--bg-alt)}
#page-settings .sm-tbl .sm-day-h{min-width:0;padding:10px 4px;text-align:center}
#page-settings .sm-tbl :is(.sm-act-h,.sm-act){width:88px;min-width:0;text-align:center;padding:6px}
#page-settings .sm-tbl .sm-cell{padding:9px 4px;text-align:center;vertical-align:middle}
#page-settings .sm-tbl .sm-t{white-space:nowrap;font-size:.68rem}
#page-settings .sm-tbl .sm-emp-n{font-size:.78rem;overflow-wrap:anywhere}
#page-settings .sm-tbl .sm-emp-m{font-size:.63rem}
#page-settings .sm-tbl .sm-act .btn{min-height:28px;padding:4px 6px;font-size:.68rem}
#page-settings .sm-tbl tbody tr:hover .sm-emp{background:var(--bg-alt)}
#page-settings .settings-pref-body input[type=checkbox]{width:17px;height:17px;accent-color:var(--primary);flex-shrink:0}
#page-settings :is(button,input,select,textarea,summary):focus-visible{outline:2px solid var(--primary);outline-offset:3px}
#page-settings .stg-search-result{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;padding:18px;margin-bottom:10px;background:var(--surface);border:1px solid var(--border);border-radius:12px;color:var(--text);font:inherit;text-align:start;cursor:pointer}
#page-settings .stg-search-result:hover{border-color:var(--primary);background:var(--primary-pale)}
#page-settings .stg-search-result strong{font-size:.86rem;line-height:1.7}
#page-settings .stg-search-result span{font-size:.72rem;color:var(--primary);flex-shrink:0}
#page-settings .stg-search-empty{padding:40px 18px;text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:14px}

@media(max-width:900px){
  #page-settings .stg-layout{grid-template-columns:minmax(0,1fr)}
}

/* Compact preferences and consistent management tables. */
#page-settings #stg-appearance-card .stg-appearance-options{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px!important;max-width:none;align-items:start}
#page-settings .stg-appearance-toggles{display:grid;gap:8px}
#page-settings .stg-appearance-toggles>label{display:flex;flex-direction:row-reverse;justify-content:space-between;gap:14px;padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--bg-alt);font-size:.8rem;line-height:1.6}
#page-settings .stg-language-options{padding:12px;border:1px solid var(--border);border-radius:10px;min-width:0}
#page-settings .stg-language-options #set-lang{max-width:100%}
#page-settings .stg-language-options #settings-lang-hint{margin-top:8px!important;line-height:1.7!important}
#page-settings :is(.stg-appearance-toggles,#stg-mov-kpi-card) input[type=checkbox]{appearance:none;width:34px!important;height:20px;min-height:20px;max-height:20px;min-width:34px;padding:0!important;box-sizing:border-box;position:relative;border:0;border-radius:20px;background:var(--border);cursor:pointer;transition:background .15s}
#page-settings :is(.stg-appearance-toggles,#stg-mov-kpi-card) input[type=checkbox]::after{content:"";position:absolute;left:3px;top:3px;width:14px;height:14px;border-radius:50%;background:#fff;box-shadow:0 1px 3px #0002;transition:transform .15s}
#page-settings :is(.stg-appearance-toggles,#stg-mov-kpi-card) input[type=checkbox]:checked{background:var(--primary)}
#page-settings :is(.stg-appearance-toggles,#stg-mov-kpi-card) input[type=checkbox]:checked::after{transform:translateX(14px)}
#page-settings .stg-search-wrap{max-width:500px;margin-bottom:18px}
#page-settings .stg-search-wrap input{min-height:36px;padding-block:7px;font-size:.8rem;border-radius:9px}
#page-settings :is(#discount-codes-section,#discount-bundles-section)>div:first-child{flex-wrap:wrap;gap:10px}
#page-settings :is(#discount-codes-section,#discount-bundles-section)>.settings-card{padding:0}
#page-settings .stg-discount-filters{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px;border-bottom:1px solid var(--border);background:var(--surface)}
#page-settings .stg-discount-filters #dc-filter-q{flex:1 1 200px;min-width:0!important;max-width:340px;font-size:.78rem;min-height:34px;margin:0}
#page-settings .stg-discount-filters select{width:auto;min-width:110px;max-width:160px;min-height:34px;margin:0;font-size:.76rem!important}
#page-settings :is(#dc-table-wrap,#db-table-wrap){max-height:460px;overflow:auto!important;scrollbar-width:thin;scrollbar-color:var(--border) transparent}
#page-settings :is(#dc-table,#db-table){font-size:.78rem;table-layout:fixed;min-width:780px;isolation:isolate}
#page-settings :is(#dc-table,#db-table) :is(th,td){padding:10px!important;text-align:start;vertical-align:middle;box-sizing:border-box;overflow-wrap:anywhere;line-height:1.65}
#page-settings :is(#dc-table,#db-table) th{position:sticky;top:0;z-index:2;background:var(--bg-alt);font-size:.69rem;white-space:nowrap;border-bottom:1px solid var(--border)}
#page-settings :is(#dc-table,#db-table) th:first-child{width:150px}
#page-settings #dc-table th:nth-child(4){width:130px}
#page-settings #dc-table th:nth-child(5){width:100px}
#page-settings #db-table{min-width:820px}
#page-settings #db-table th:first-child{width:140px}
#page-settings #db-table th:nth-child(2){width:160px}
#page-settings #db-table th:nth-child(3){width:100px}
#page-settings #db-table th:nth-child(4){width:50px}
#page-settings #db-table th:nth-child(5),#page-settings #db-table th:nth-child(6){width:70px}
#page-settings #db-table th:nth-child(7){width:75px}
#page-settings :is(#dc-table,#db-table) :is(th,td):last-child{width:166px;position:sticky;inset-inline-end:0;background:var(--surface);border-inline-start:1px solid var(--border);z-index:1}
#page-settings :is(#dc-table,#db-table) th:last-child{background:var(--bg-alt);z-index:3}
#page-settings #db-table :is(th,td):last-child{width:154px}
#page-settings .stg-table-actions{display:flex;align-items:center;justify-content:flex-end;gap:5px;white-space:nowrap}
#page-settings .stg-table-actions :is(.btn,.btn-icon){display:inline-flex;align-items:center;justify-content:center;height:28px;min-height:28px;font-size:.7rem!important;padding:4px 7px!important;line-height:1.3;border-radius:7px;flex-shrink:0}
#page-settings .stg-table-actions .btn-icon{width:28px;border:1px solid var(--border);background:var(--surface)}
#page-settings .stg-table-actions .btn-danger{color:var(--red);border-color:color-mix(in srgb,var(--red) 25%,var(--border));background:color-mix(in srgb,var(--red) 5%,var(--surface))}
#page-settings #db-table .db-prod-tag{max-width:100%;white-space:normal;line-height:1.5}
#page-settings .stg-tag-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
#page-settings .stg-inline-search{display:flex;align-items:center;gap:8px;max-width:340px;flex:1;min-width:0;padding:0 10px;background:var(--bg-alt);border:1px solid var(--border);border-radius:9px;color:var(--muted);margin:0}
#page-settings .stg-inline-search:focus-within{border-color:var(--primary);outline:2px solid var(--primary-pale)}
#page-settings .stg-inline-search svg{flex-shrink:0}
#page-settings .stg-inline-search input{width:100%;min-width:0;min-height:34px;border:0;box-shadow:none;background:transparent;padding:6px 0;font-size:.78rem;margin:0}
#page-settings .stg-inline-search input:focus{outline:none;box-shadow:none;border:0}
#page-settings #stg-tag-count{color:var(--muted);font-size:.7rem;white-space:nowrap}
#page-settings .stg-tag-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-height:340px;overflow:auto;scrollbar-width:thin}
#page-settings .stg-managed-tag{display:flex;align-items:center;gap:8px;padding:10px;min-width:0;border:1px solid var(--border);border-radius:9px;background:var(--bg-alt)}
#page-settings .stg-managed-tag[hidden],#page-settings .stg-tags-empty[hidden]{display:none}
#page-settings .stg-managed-tag .tx-tag{min-width:0;max-width:100%;overflow-wrap:anywhere;white-space:normal;margin-inline-end:auto;font-size:.73rem}
#page-settings .stg-managed-tag select{width:100px;min-width:0;flex:0 0 100px;font-size:.7rem;border:1px solid var(--border);border-radius:7px;padding:5px;background:var(--surface);color:var(--text);margin:0}
#page-settings .stg-tag-delete{display:grid;place-items:center;flex:0 0 28px;height:28px;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--red);cursor:pointer}
#page-settings .stg-tag-delete:hover{border-color:var(--red)}
#page-settings .stg-tags-empty{padding:24px;text-align:center;color:var(--muted);font-size:.8rem;border:1px dashed var(--border);border-radius:9px}
#page-settings .stg-tag-add{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding-top:14px;margin-top:14px;border-top:1px solid var(--border)}
#page-settings #new-master-tag-name{flex:1 1 160px!important;max-width:300px;min-height:34px;font-size:.78rem}
#page-settings #new-master-tag-category{width:120px;font-size:.76rem;min-height:34px}
#page-settings .stg-tag-add .btn{white-space:nowrap}
@media(max-width:640px){
  #page-settings #stg-ship-companies-card .settings-ship-add{grid-template-columns:minmax(0,1fr) auto;gap:10px}
  #page-settings .settings-ship-add .stg-ship-name-field{grid-column:1/-1}
  #page-settings .stg-shipping-table-wrap{border:0;overflow:visible;max-height:none}
  #page-settings #ship-table{display:block;min-width:0}
  #page-settings #ship-table thead{display:none}
  #page-settings #ship-table tbody{display:grid;gap:10px}
  #page-settings #ship-table tbody tr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface)}
  #page-settings #ship-table tbody td{display:block;padding:10px;border:0;min-width:0}
  #page-settings #ship-table tbody td:first-child{grid-column:1/-1;border-bottom:1px solid var(--border)}
  #page-settings #ship-table tbody td[data-label]::before{content:attr(data-label);display:block;font-size:.68rem;color:var(--muted);margin-bottom:5px}
  #page-settings #ship-table input[type=number]{width:100%;max-width:none;margin:0}
  #page-settings #ship-table tbody td:last-child{grid-column:1/-1;position:static;width:auto;border-top:1px solid var(--border);padding:8px 10px}
  #page-settings .stg-ship-actions{justify-content:flex-end}
  #page-settings #ship-table .empty-state{grid-column:1/-1}
  #page-settings #stg-appearance-card .stg-appearance-options{grid-template-columns:minmax(0,1fr);gap:12px!important}
  #page-settings .stg-tag-list{grid-template-columns:minmax(0,1fr)}
  #page-settings .stg-discount-filters #dc-filter-q{flex-basis:100%;max-width:100%}
  #page-settings .stg-discount-filters select{flex:1;min-width:0;max-width:none}
  #page-settings .stg-tag-toolbar{flex-wrap:wrap}
  #page-settings .stg-inline-search{max-width:100%}
  #page-settings #new-master-tag-name{flex-basis:100%!important;max-width:none}
  #page-settings :is(#dc-table,#db-table) :is(th,td):last-child{width:154px}
}
@media(max-width:640px){
  #page-settings .stg-provider-tabs{gap:6px}
  #page-settings .stg-provider-tabs button{flex-direction:column;align-items:center;text-align:center;padding:10px 4px;gap:6px}
  #page-settings .stg-provider-tabs small{display:none}
  #page-settings .stg-provider-brand{flex-basis:34px;height:34px;width:58px}
  #page-settings .stg-provider-tabs strong{font-size:.7rem}
  #page-settings{width:100%;padding:12px;box-sizing:border-box}
  #page-settings .settings-page-inner{padding:0;width:100%}
  #page-settings .stg-layout{gap:14px}
  #page-settings .stg-grid-2,#page-settings .settings-price-grid{grid-template-columns:minmax(0,1fr)}
  #page-settings .settings-card{padding:12px}
  #page-settings .settings-price-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  #page-settings .settings-ship-add #new-ship-name{width:100%}
  #page-settings .settings-ship-prices{flex:1;grid-template-columns:repeat(2,minmax(0,1fr))}
  #page-settings #an-composer .an-types{grid-template-columns:repeat(2,minmax(0,1fr))}
  #page-settings .stg-content-heading{margin-bottom:16px;padding-bottom:14px}
  #page-settings .stg-content-heading h3{font-size:1rem}
  #page-settings .stg-content-heading p{font-size:.72rem}
  #page-settings .stg-search-result{padding:14px;align-items:flex-start;flex-direction:column;gap:5px}
  #page-settings .settings-pref-body .flex{min-width:0;align-items:flex-start}
  #page-settings .settings-pref-body .flex>span{min-width:0;white-space:normal}
  #page-settings .settings-pref-body .flex>input[type="checkbox"]{flex-shrink:0}
  #page-settings .settings-card>.flex{flex-wrap:wrap}
  #page-settings .page-header>div{min-width:0;max-width:100%}
  #notification-settings{padding:12px!important}
  #notification-settings .push-setting-row{display:grid!important;grid-template-columns:32px minmax(0,1fr) 44px;gap:8px;padding:12px 10px!important}
  #notification-settings .push-master{padding:12px 10px!important}
  #notification-settings .push-setting-copy{overflow-wrap:anywhere}
  #notification-settings .push-switch{margin-inline-start:0}
  #notification-settings .push-language-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,115px);gap:10px}
  #notification-settings #push-language{width:100%;max-width:115px;min-width:0}
  #notification-settings .push-device-card{padding:12px;min-width:0}
  #notification-settings .push-actions{grid-template-columns:repeat(2,minmax(0,1fr))}
  #notification-settings .push-action{min-width:0;max-width:100%;white-space:normal;overflow-wrap:anywhere}
}
@media(prefers-reduced-motion:reduce){
  #page-settings *,#page-settings *::before,#page-settings *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
@media(max-width:380px){
  #notification-settings .push-actions{grid-template-columns:minmax(0,1fr)}
  #notification-settings .push-action{width:100%;margin:0}
}

    LEGACY_STOCK_MISMATCH: ['Registered pieces do not match the warehouse balance. Reconcile the stock first.', 'القطع المكودة لا تتوافق مع رصيد المخزن. راجع الجرد أولًا.'],
    LEGACY_COUNT_OUT_OF_RANGE: ['Physical quantity must include already coded pieces and cannot exceed the warehouse balance.', 'العدد الفعلي يجب أن يشمل القطع المكودة بالفعل وألا يتجاوز رصيد المخزن.'],
    LEGACY_ALREADY_CODED: ['These pieces already have codes. View or reprint the existing labels.', 'هذه القطع لها أكواد بالفعل. اعرض الملصقات الموجودة أو أعد طباعتها.'],
    LEGACY_BATCH_LIMIT: ['Create up to 100 new piece codes per batch, then continue with another batch.', 'أنشئ حتى 100 كود جديد في الدفعة، ثم أكمل في دفعة أخرى.'],
    ORDER_NOT_FOUND: ['Customer order not found. Refresh the order list.', 'طلب العميل غير موجود. حدّث قائمة الطلبات.'],
    ORDER_INACTIVE: ['This order is cancelled or archived and cannot be prepared.', 'الطلب ملغى أو مؤرشف ولا يمكن تحضيره.'],
    ORDER_DISPATCHED: ['This order has already left the warehouse. A damaged-label skip cannot be recorded.', 'الطلب خرج من المخزن بالفعل. لا يمكن تسجيل تخطي ملصق تالف.'],
    ORDER_ALREADY_PREPARED: ['Undo preparation approval before recording a damaged-label skip.', 'تراجع عن اعتماد التحضير أولًا قبل تسجيل ملصق تالف.'],
    ORDER_NOT_PREPARING: ['This order is not being prepared. Refresh the orders and move it to preparation first.', 'الطلب ليس قيد التجهيز. حدّث الطلبات وانقله إلى التحضير أولًا.'],
    DUPLICATE_SCAN: ['This piece was already scanned for this order. Scan another piece.', 'تم مسح هذه القطعة لهذا الطلب بالفعل. امسح قطعة أخرى.'],
    UNIT_ASSIGNED_ELSEWHERE: ['This piece is assigned to another order. Scan an available piece.', 'هذه القطعة مخصصة لطلب آخر. امسح قطعة متاحة.'],
    LABEL_REPRINT_CONFIRMATION_REQUIRED: ['A selected barcode has previous print requests. Refresh the preview and confirm reprinting.', 'سبق طلب طباعة باركود ضمن التحديد. حدّث المعاينة وأكّد إعادة الطباعة أولًا']
  };
  const translations = new Map();
  for (const row of rows) for (const phrase of row) translations.set(phrase, row);
  function translate(value, code, status, details) {
    const en = typeof currentLang !== 'undefined' && currentLang === 'en';
    const pick = pair => pair[en ? 0 : 1];
    if (['UNIT_RETURNED_TO_SUPPLIER', 'UNIT_PENDING_SUPPLIER_RETURN'].includes(code)) return window.SupplierReturnPieces?.returnMessage(details?.supplierReturn, code === 'UNIT_PENDING_SUPPLIER_RETURN') || pick(['This piece is linked to a supplier return.', 'هذه القطعة مرتبطة بمرتجع مورد.']);
    if (codes[code]) return pick(codes[code]);
    const raw = String(value || '').trim();
    if (translations.has(raw)) return pick(translations.get(raw));
    if (raw.includes('; ') && raw.split('; ').every(part => translations.has(part))) return raw.split('; ').map(part => pick(translations.get(part))).join(' · ');
    if (/^Permission required:/.test(raw) || status === 403) return pick(['You do not have permission for this action. Contact an administrator.', 'ليس لديك صلاحية لهذا الإجراء. تواصل مع المسؤول.']);
    const quantity = raw.match(/^Confirmed physical quantity must be between (\d+) and (\d+)$/);
    if (quantity) return pick([`Physical quantity must be between ${quantity[1]} and ${quantity[2]}.`, `الكمية الفعلية يجب أن تكون بين ${quantity[1]} و${quantity[2]}.`]);
    if (/^(Scan and prepare all|Scan or record a damaged-label exception|Barcode identity coverage is incomplete)/.test(raw)) return pick(['Preparation is incomplete. Scan every piece or record a damaged-label exception for the remaining pieces.', 'التحضير غير مكتمل. امسح كل قطعة أو سجل استثناء ملصق تالف للقطع المتبقية.']);
    if (/^(Invalid preparation quantity|Scanned\/assigned units and damaged-label exceptions)/.test(raw)) return pick(['Piece quantities do not match the invoice. Refresh the order and review scans and skips.', 'كميات القطع لا تطابق الفاتورة. حدّث الطلب وراجع المسح والتخطي.']);
    if (/سبب.*التراجع.*مطلوب/.test(raw)) return pick(['Enter a reason for undoing preparation.', 'أدخل سبب التراجع عن التحضير.']);
    if (status === 401) return pick(['Your session has expired. Sign in again.', 'انتهت جلسة الدخول. سجّل الدخول مجددًا.']);
    if (status >= 500) return pick(['The server could not complete the request. Its outcome may be unknown; check or retry the same pending request.', 'تعذر إكمال الطلب على الخادم وقد تكون نتيجته غير مؤكدة. استعلم عن الطلب المعلق أو أعد نفس الطلب.']);
    if (status === 404) return pick(['The requested record was not found. Refresh the data.', 'السجل المطلوب غير موجود. حدّث البيانات.']);
    if (status === 409) return pick(['The data or operation state changed. Refresh it before continuing.', 'تغيرت البيانات أو حالة العملية. حدّثها قبل المتابعة.']);
    if (status === 400 || status === 422) return pick(['Some entered values are invalid or missing. Review the form.', 'بعض البيانات المدخلة غير صحيحة أو ناقصة. راجع النموذج.']);
    return raw || pick(['The operation could not be completed. Try again.', 'تعذر إكمال العملية. حاول مجددًا.']);
  }
  window.InventoryErrors = { translate };
})();

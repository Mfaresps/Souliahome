# Server-only Docker Compose / Jenkins deployment configuration.
# Copy to .env beside docker-compose.yml on the deployment server.
# Use the EXISTING signing secret from Shopify; do not generate a new value.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_NAME=
SHOPIFY_ACCESS_TOKEN=

# Optional explicit push credentials; omit to use the persisted server pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://admin.soulia.store
TZ=Africa/Cairo
BUSINESS_TZ=Africa/Cairo

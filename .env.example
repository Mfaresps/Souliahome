# Optional server-only Docker Compose / Jenkins environment fallback.
# Shopify credentials can also be saved in Settings > Shipping > Shopify.
# For environment configuration, copy beside docker-compose.yml on the server.
# Use the EXISTING signing secret from Shopify; do not generate a new value.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_NAME=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional explicit push credentials; omit to use the persisted server pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://admin.soulia.store
TZ=Africa/Cairo
BUSINESS_TZ=Africa/Cairo
